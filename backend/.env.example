# Copy to backend/.env and fill in your own values.
# Every key is read from the environment; nothing here is committed with real values.

GOOGLE_API_KEY=    # legacy / ya no usado en el agente
GROQ_API_KEY=    # fallback LLM: llama-3.3-70b-versatile (free tier)
CEREBRAS_API_KEY=    # primary LLM: gpt-oss-120b (cloud.cerebras.ai)
OPENAI_API_KEY=    # embeddings RAG (text-embedding-3-small)
VOYAGE_API_KEY=    # embeddings RAG (voyage-multilingual-2, free tier)
SUPABASE_URL=
SUPABASE_KEY=    # nombre que usa Vercel
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
