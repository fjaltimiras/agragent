{
  "functions": {
    "api/chat.js": { "maxDuration": 30 },
    "api/chat-stream.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/chat/stream", "destination": "/api/chat-stream" },
    { "source": "/api/chat/new", "destination": "/api/chat-new" },
    { "source": "/api/chat/", "destination": "/api/chat" },
    { "source": "/api/conversations/:path*", "destination": "/api/conversations" },
    { "source": "/api/fields/:path*", "destination": "/api/fields" },
    { "source": "/", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
      ]
    }
  ]
}
