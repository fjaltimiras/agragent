# Server-side settings for the api/ functions (Vercel → Project → Settings → Environment Variables).
# Copy to .env.local for `vercel dev`. Never commit real values.

# Supabase (service_role key: server only, never in config.js)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated browser origins allowed to call the API (e.g. https://app.example.org).
# http://localhost and http://127.0.0.1 are always allowed.
ALLOWED_ORIGINS=

# Tenants accepted in app_metadata.tenant (comma-separated). Must include config.js → tenant.
APP_TENANTS=agragent
# Daily assistant messages per user
CHAT_DAILY_LIMIT=150
# Optional: token for server-to-server calls (X-Service-Token header), e.g. the evaluation harness
APP_API_TOKEN=

# LLM providers (OpenAI-compatible endpoints; Cerebras first, Groq as fallback)
CEREBRAS_API_KEY=
GROQ_API_KEY=

# Google Earth Engine service account (key JSON → base64 of its private_key)
GEE_CLIENT_EMAIL=
GEE_PRIVATE_KEY_B64=
GEE_PROJECT_ID=

# Nominatim usage policy asks for an identifying User-Agent with contact
NOMINATIM_USER_AGENT=agragent (self-hosted; you@example.org)
